# 이 파일을 .env로 복사해서 쓰세요. (.env는 git에 올라가지 않아요)

# ---- DB ----
POSTGRES_USER=inyeongori
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inyeongori
# 로컬에서 백엔드를 직접 실행할 때 (docker-compose 안에서는 compose가 db 호스트로 덮어써요)
DATABASE_URL=postgresql+psycopg://inyeongori:change-me@localhost:5432/inyeongori
TEST_DATABASE_URL=postgresql+psycopg://inyeongori:change-me@localhost:5432/inyeongori_test

# ---- 인증 ----
# 아무 긴 랜덤 문자열. 예: py -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000

# ---- AI ----
# true면 LLM·임베딩을 호출하지 않고 고정 예시 응답을 써요 (키가 없어도 앱이 돌아가요)
AI_MOCK=true
LLM_PROVIDER=gemini
# Google AI Studio(https://aistudio.google.com)에서 무료로 발급
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# 로컬: local + BAAI/bge-m3 / 배포: gemini + gemini-embedding-001 (docs/deploy.md)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- 시드 ----
# 데모 시드 계정 비밀번호 (비우면 README의 기본값)
SEED_PASSWORD=

# ---- 프론트엔드 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
